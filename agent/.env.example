# Copy to .env (same folder). Never commit .env.

OPENAI_API_KEY=

# Base URL of the RAG backend (backend/app/main.py), no trailing slash.
VLEARN_BACKEND_URL=http://localhost:8000

# Notion export (export_api.py /export/notion). Integration token from
# notion.so/my-integrations; the target database must be shared with it.
NOTION_API_KEY=
NOTION_DATABASE_ID=
