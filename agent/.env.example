# Copy to .env (same folder). Never commit .env.

OPENAI_API_KEY=

# Base URL of the RAG backend (backend/app/main.py), no trailing slash.
VLEARN_BACKEND_URL=http://localhost:8000

# Notion export (export_api.py /export/notion).
# 1. Create an internal integration at notion.so/my-integrations, copy its token below.
# 2. Open any Notion page, Share -> Connections -> add that integration.
# 3. Paste that page's URL (or bare 32-char id) below — no database/columns needed.
NOTION_API_KEY=
NOTION_PAGE_ID=
